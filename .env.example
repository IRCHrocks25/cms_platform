# ---------------------------------------------------------------------------
# cms_platform — sample environment
# Copy to `.env` for local dev, or set these in your prod environment.
# ---------------------------------------------------------------------------

# Django secret key. The default in settings.py is a dev placeholder; for
# any non-dev environment this MUST be set to a random, private value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-secret-change-me-in-production

# Debug mode. "1" enables Django DEBUG, "0" disables it.
# Production: set to 0.
DJANGO_DEBUG=1

# Base domain for tenant subdomain routing.
#   - Dev default: localhost (Chrome/Firefox auto-resolve *.localhost via RFC 6761)
#   - If your DNS doesn't honor *.localhost, use lvh.me  → http://acme.lvh.me:8000/
#   - Production: your real wildcard host, e.g. sites.youragency.com
#     (and point *.sites.youragency.com at this app via Caddy/nginx/Cloudflare)
TENANT_BASE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Claude OAuth client.
# Provision these values through your secret manager, then run:
#   python manage.py register_claude_oauth_client
# Redirect URIs are space-separated. The command is idempotent and never prints
# the secret; use the same provisioned values anywhere the client must match.
# ---------------------------------------------------------------------------
CLAUDE_OAUTH_CLIENT_ID=
CLAUDE_OAUTH_CLIENT_SECRET=
CLAUDE_OAUTH_REDIRECT_URIS=

# ---------------------------------------------------------------------------
# Custom client domains (direct-to-origin + Let's Encrypt).
# Clients point an A record at this origin IP; Traefik then issues a real
# Let's Encrypt cert per domain via HTTP-01. The dashboard's verify step checks
# the domain's A record resolves here. Prod default is the Hetzner origin IP.
# ---------------------------------------------------------------------------
CUSTOM_DOMAIN_TARGET_IP=5.78.149.237

# ---------------------------------------------------------------------------
# OpenAI HTML annotation.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ANNOTATE_MODEL=gpt-5.6-luna
# Luna supports none, low, medium, high, xhigh, and max. This option is sent
# only for Luna because GPT-4o and GPT-4o-mini reject reasoning_effort.
OPENAI_ANNOTATE_REASONING_EFFORT=medium
# Optional override for models whose completion cap is not built into the
# annotator. Luna defaults to 65536; gpt-4.1 models default to 32768; other
# model overrides default to the conservative 16384-token cap.
# OPENAI_ANNOTATE_MAX_COMPLETION_TOKENS=65536
# These operational limits deliberately remain below the total model context.
# Each request sees one 40000-character chunk; the 500000-character ceiling
# limits total API calls, cost, and wall-clock time for one annotation job.
ANNOTATE_MAX_INPUT_CHARS=500000
ANNOTATE_CHUNK_TARGET_CHARS=40000

# ---------------------------------------------------------------------------
# GHL (GoHighLevel) marketplace app integration.
# ---------------------------------------------------------------------------
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Fernet key for encrypting GHL tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GHL_TOKEN_ENCRYPTION_KEY=
# Optional: explicit GHL app version id (defaults to the GHL_CLIENT_ID prefix).
GHL_APP_VERSION_ID=
# Optional: override the chooselocation hosts if GHL changes them again.
# GHL_CHOOSELOCATION_URL is the whitelabel (default) variant; _STANDARD is
# used by /connect/install/?variant=standard. See core/ghl_oauth.py.
GHL_CHOOSELOCATION_URL=
GHL_CHOOSELOCATION_URL_STANDARD=

# ---------------------------------------------------------------------------
# Iceberg — client media host (images + video), served from cdn.katalyst-crm.com
# Mint a token in the Iceberg dashboard (tenant_admin). Keep ICEBERG_TOKEN secret.
# ---------------------------------------------------------------------------
ICEBERG_API_URL=
ICEBERG_TOKEN=
ICEBERG_CDN=https://cdn.katalyst-crm.com
ICEBERG_TENANT=t1
